      "_source_file": "Maldives/Piyush_Maldives_All Inclusive Guide.docx",
      "_source_date": "2026-04-25",
      "_source_format": "new"
    },
    {
      "tip": "Bringing alcohol, pork products or religious materials for distribution into the country is prohibited",
      "_source_file": "Maldives/Piyush_Maldives_All Inclusive Guide.docx",
      "_source_date": "2026-04-25",
      "_source_format": "new"
    },
    {
      "tip": "Do not touch coral reefs or collect shells from the ocean, as marine life is protected",
      "_source_file": "Maldives/Piyush_Maldives_All Inclusive Guide.docx",
      "_source_date": "2026-04-25",
      "_source_format": "new"
    },
    {
