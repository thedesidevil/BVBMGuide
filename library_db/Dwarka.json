  "attractions": [
    {
      "name": "Dwarkadhish Temple",
      "city": "Dwarka",
      "description": "Also known as Jagat Mandir, this is the spiritual heart of Dwarka and one of the most revered Krishna temples in India. A magnificent five-storied structure supported by intricately carved pillars, symbolising devotion and architectural excellence.",
      "hours": "7:00 AM – 12:30 PM & 5:00 PM – 9:00 PM",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Sudama Setu",
      "city": "Dwarka",
      "description": "Pedestrian suspension bridge spanning the Gomti River, offering beautiful views of Dwarkadhish Temple, the riverfront, and the Arabian Sea. Named after Lord Krishna's childhood friend Sudama.",
      "hours": "7:00 AM – 1:00 PM & 4:00 PM – 7:30 PM",
      "entry_fee": "Approx. ₹10 per person",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Rukmini Devi Temple",
      "city": "Dwarka",
      "description": "Dedicated to Rukmini, the chief consort of Lord Krishna. Known for its intricate architecture and spiritual significance. One of Dwarka's most important pilgrimage sites with peaceful surroundings.",
      "hours": "7:30 AM – 8:00 PM",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Nageshwar Jyotirlinga Temple",
      "city": "Dwarka",
      "description": "One of the twelve sacred Jyotirlingas of Lord Shiva, attracting devotees from across the country. Features a towering Shiva statue and tranquil temple complex creating a spiritually uplifting atmosphere.",
      "hours": "6:00 AM – 9:00 PM",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Bet Dwarka",
      "city": "Dwarka",
      "description": "Located on an island off the coast of Dwarka, believed to have been Lord Krishna's residence. Visitors take a short ferry ride to reach the island. Known for its temples, coastal views, and spiritual significance.",
      "hours": "6:00 AM – 6:00 PM",
      "entry_fee": "Ferry Charges: Approx. ₹30–50 per person (subject to change)",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
