  "health_tips": [
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "No special travel vaccinations are mandatory for Indian travellers to the Netherlands, Belgium, or Germany. All three countries have excellent healthcare systems.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Ensure routine vaccinations are up to date: Tetanus, Diphtheria, Polio, MMR (Measles, Mumps, Rubella), and seasonal Influenza.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Recommended optional vaccinations for travel: Hepatitis A (exposure through food/travel dining), Hepatitis B (optional for long stays), Typhoid (broader travel hygiene protection).",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Tap water is safe to drink in all destinations.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Carry basic medications for cold, fever, and stomach upset. Use hand sanitizer regularly, especially in public transport and markets.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Stay hydrated, especially during walking-heavy sightseeing days. Wear comfortable footwear to avoid strain from cobblestone streets.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Use sunscreen even in mild May weather — UV exposure is still present.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Mosquito risk is very low, but mild repellents can be useful in parks. If prone to allergies, carry antihistamines due to spring pollen exposure.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Suggested travel medical kit: Paracetamol/pain reliever, antacids/digestion tablets, motion sickness tablets (for trains and canal/Rhine cruises), band-aids and antiseptic cream, ORS (oral rehydration salts), and personal prescription medicines with copy of prescription.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    },
    {
      "cities": [
        "Netherlands",
        "Belgium",
        "Germany"
      ],
      "tip": "Excellent hospitals and pharmacies are widely available in all cities. Pharmacies are marked as 'Apotheek' in Netherlands/Belgium and 'Apotheke' in Germany. English-speaking staff are common in major cities.",
      "_source_file": "Europe/Sirisha_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778114484.0
    }
  ],
