      "_source_file": "Maldives/Piyush_Maldives_All Inclusive Guide.docx",
      "_source_date": "2026-04-25",
      "_source_format": "new"
    },
    {
      "tip": "Some shops in local areas open later or close temporarily on Fridays, the day of prayer",
      "_source_file": "Maldives/Piyush_Maldives_All Inclusive Guide.docx",
      "_source_date": "2026-04-25",
      "_source_format": "new"
    },
    {
