  "connectivity_tips": [
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "You can purchase a TSIM Unlimited Europe SIM card which will work in both Switzerland and Italy",
      "_source_file": "Italy/All Inclusive Guide- Aayush and Sonal- Switzerland and Italy.pdf",
      "_source_mtime": 1772384343.3418624
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "You can activate international roaming packs on your India number as an alternative",
      "_source_file": "Italy/All Inclusive Guide- Aayush and Sonal- Switzerland and Italy.pdf",
      "_source_mtime": 1772384343.3418624
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "Ensure your roaming is activated to receive SMS such as for OTPs even if you don't purchase an international roaming pack",
      "_source_file": "Italy/All Inclusive Guide- Aayush and Sonal- Switzerland and Italy.pdf",
      "_source_mtime": 1772384343.3418624
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "Best setup: One Europe-wide SIM or eSIM with WiFi backup strategy. Switzerland and Italy are both supported by EU roaming providers via Italy-based SIMs or global eSIMs.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "eSIM is most recommended. Providers include Airalo (Europe eSIM), Holafly (Unlimited data plans), and Nomad eSIM (Flexible regional packs). Offers instant activation, works immediately upon landing, keeps primary SIM active for OTPs, and no risk of losing physical SIM.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "Suggested eSIM plan: 10–20 GB for light usage (maps, WhatsApp, bookings) or unlimited plan for heavy navigation and uploads.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy"
      ],
      "tip": "Local SIM in Italy available at Milano Centrale Station, Venice Mestre/Santa Lucia kiosks, Rome Termini Station, and official mobile stores. Best providers: TIM (best coverage), Vodafone Italy (strong urban + travel routes), WindTre (budget-friendly). Typical cost: €15–€30 for 20–50 GB plans. Passport required for SIM registration.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "Download offline maps of Switzerland (entire region) and Northern + Central Italy before travelling. Upload photos only on WiFi when possible. Avoid streaming during train rides unless on unlimited plan. Turn off background app refresh for non-essential apps.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Switzerland",
        "Italy"
      ],
      "tip": "Essential apps: Trenitalia App and Italo Treno App for Italy trains; SBB Mobile for Switzerland trains; Google Maps and Maps.me for navigation; WhatsApp for communication.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "France",
        "Switzerland",
        "Italy"
      ],
      "tip": "An eSIM is the easiest and most convenient option for multi-country Europe trips. Recommended providers: Airalo, Holafly, Nomad. Works across multiple European countries with no physical SIM swapping required.",
      "_source_file": "Europe/Vidhi_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778731348.0
    },
    {
      "cities": [
        "Italy"
      ],
      "tip": "Local SIM cards available from TIM, Vodafone Italy, and Iliad. Purchase at Venice Mestre station, Florence city centre, or Rome Termini station. Passport required. Strong coverage across cities, tourist attractions, and train routes.",
      "_source_file": "Europe/Vidhi_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778731348.0
