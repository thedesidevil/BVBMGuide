  "safety_tips": [
    {
      "cities": [
        "Italy"
      ],
      "tip": "Italy is generally safe but tourist areas require vigilance. Main focus is pickpocket prevention in crowded zones.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy",
        "Switzerland"
      ],
      "tip": "Keep bags in front in crowded areas, especially in Venice, Rome, and Milan stations. Avoid loose pockets for phones and wallets.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy",
        "Switzerland"
      ],
      "tip": "Always keep luggage within sight on trains. Never leave bags unattended at stations. Be alert at major hubs: Milano Centrale, Roma Termini, Venezia Santa Lucia.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy",
        "Switzerland"
      ],
      "tip": "Keep passport and ticket copies in your phone and cloud backup. Enable mobile banking alerts for transactions.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy",
        "Switzerland"
      ],
      "tip": "Prefer official taxis or trains after 9–10 PM. Stick to well-lit, active streets at night.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy"
      ],
      "tip": "Use official taxis (white cars with taxi sign). Apps like Free Now work well. Avoid unlicensed taxis near tourist spots.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "Italy"
      ],
      "tip": "Allow buffer time for train connections. Validate regional tickets before boarding. Stations can be busy — stay aware.",
      "_source_file": "Europe/Kunal_Europe_All Inclusive Guide(1).docx",
      "_source_mtime": 1777831784.0
    },
    {
      "cities": [
        "France",
        "Switzerland",
        "Italy"
      ],
      "tip": "Keep valuables secure in crowded tourist areas, metro stations, and train platforms.",
      "_source_file": "Europe/Vidhi_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778731348.0
    },
    {
      "cities": [
        "France",
        "Switzerland",
        "Italy"
      ],
      "tip": "Avoid keeping phones or wallets loosely in jacket pockets while sightseeing.",
      "_source_file": "Europe/Vidhi_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778731348.0
    },
    {
      "cities": [
        "France",
        "Switzerland",
        "Italy"
      ],
      "tip": "Use official taxis or trusted ride apps where available.",
      "_source_file": "Europe/Vidhi_Europe_All Inclusive Guide.docx",
      "_source_mtime": 1778731348.0
    },
