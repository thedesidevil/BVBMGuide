  "attractions": [
    {
      "name": "Somnath Temple",
      "city": "Somnath",
      "description": "One of the twelve sacred Jyotirlingas of Lord Shiva, standing majestically along the Arabian Sea. Known for its grand architecture, spiritual atmosphere, and coastal setting. The rhythmic sound of temple bells and crashing waves creates a deeply peaceful and devotional experience.",
      "hours": "6:00 AM – 10:00 PM",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Triveni Sangam",
      "city": "Somnath",
      "description": "Sacred confluence of the Hiran, Kapila, and the mythical Saraswati rivers. Devotees visit for prayers and ritual bathing. Known for calm waters and deep spiritual significance.",
      "hours": "Sunrise to Sunset",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    },
    {
      "name": "Bhalka Tirth",
      "city": "Somnath",
      "description": "Believed to be the sacred place where Lord Krishna was accidentally struck by an arrow before leaving his earthly form. The temple and surrounding complex offer a tranquil setting for reflection and prayer.",
      "hours": "6:00 AM – 9:00 PM",
      "entry_fee": "Free",
      "recommended_duration": null,
      "source_files": [
        "Gujarat/Shweta- Somnath+Dwaraka_All_Inclusive_Guide.docx"
      ]
    }
