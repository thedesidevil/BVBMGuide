      ]
    },
    {
      "name": "Sabarmati Riverfront",
      "city": "Ahmedabad",
      "description": "Beautifully developed riverfront with landscaped promenades, river views, and open public spaces. One of Ahmedabad's most popular attractions, especially scenic in the evening when city lights reflect on the river.",
